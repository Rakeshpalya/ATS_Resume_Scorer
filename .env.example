# Copy this file to .env and replace placeholders with your own values.
# Never commit .env or put real credentials in this template.

# Required for resume/JD parsing through Groq.
GROQ_API_KEY=replace_with_groq_api_key

# Required for Supabase auth and saved analysis history.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Required only for legacy HS256 Supabase JWT verification.
# Newer asymmetric signing keys are verified using Supabase JWKS.
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

# Optional overrides.
AUTH_REDIRECT_URL=http://localhost:8501
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
